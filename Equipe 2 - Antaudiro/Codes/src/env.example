# Copier en .env et renseigner les valeurs.
# .env n'est jamais commité.

# URI du serveur MLflow.
# Par défaut : SQLite dans le volume Docker mlflow_data.
# Exemple distant : https://user-moncompte.example.fr/
MLFLOW_TRACKING_URI=

# Credentials MLflow (si authentification requise)
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
